<div class="tickets-page">
  <div class="tickets-container">
    <% @tickets.each do |ticket| %>
      <div
        class="ticket-card <%= "used" if ticket.used %>"
        data-ticket-id="<%= ticket.id %>"
        data-updated-at="<%= ticket.updated_at.iso8601 %>">

        <div class="ticket-image-wrapper">
          <%= image_tag "tickets/ticket_unused.png", class: "ticket-image" %>
        </div>
      </div>
    <% end %>
  </div>
</div>