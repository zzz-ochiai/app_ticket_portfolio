<h1>チケット一覧</h1>

<% if @tickets.any? %>
  <% @tickets.each do |ticket| %>
    <div>
      <p>チケットID: <%= ticket.id %></p>

      <button type="button" class="ticket-button" data-used="<%= ticket.used %>">
        <%= ticket.used ? "使用済み" : "未使用" %>
      </button>
    </div>
  <% end %>
<% else %>
  <p>まだチケットはありません</p>
<% end %>