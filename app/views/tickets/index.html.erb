<h1>チケット一覧</h1>

<% @tickets.each do |ticket| %>
  <div class="ticket-item">
    <span class="ticket-status"><%= ticket.used ? "使用済み" : "未使用" %></span>

    <button
      type="button"
      class="ticket-button"
      data-used="<%= ticket.used %>"
      data-ticket-id="<%= ticket.id %>">
      <%= ticket.used ? "未使用に戻す" : "使用済みにする" %>
    </button>
  </div>
<% end %>