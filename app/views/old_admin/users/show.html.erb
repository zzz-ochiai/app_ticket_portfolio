<h1>ユーザー詳細</h1>

<div class="admin-container">
  <div class="admin-card">
    <p><strong>ID:</strong> <%= @user.id %></p>
    <p><strong>メール:</strong> <%= @user.email %></p>
    <p>
      <strong>権限:</strong>
      <span class="role-badge <%= @user.admin? ? 'admin' : 'general' %>">
        <%= @user.admin? ? "管理者" : "一般" %>
      </span>
    </p>
  </div>

  <h2>チケット一覧</h2>

  <% if @user.tickets.any? %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>状態</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @user.tickets.each do |ticket| %>
          <tr>
            <td><%= ticket.id %></td>
            <td>
              <span class="ticket-status <%= ticket.used? ? 'used' : 'unused' %>">
                <%= ticket.used? ? "使用済み" : "未使用" %>
              </span>
            </td>
            <td>
              <% if ticket.used? %>
                <%= button_to "未使用に戻す", revert_old_admin_ticket_path(ticket), method: :patch, class: "admin-button" %>
              <% else %>
                -
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>チケットはありません</p>
  <% end %>

  <p class="back-link">
    <%= link_to "一覧に戻る", old_admin_users_path %>
  </p>
</div>